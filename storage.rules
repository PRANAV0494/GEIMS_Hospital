rules_version = '2';

// Voice notes contain PHI audio - staff-only access.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null;
    }

    match /voice_messages/{fileName} {
      // Authenticated staff can read voice notes for care coordination.
      allow read: if isStaff();

      // Uploads: staff only, audio only, capped at 10 MB.
      allow write: if isStaff()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      allow delete: if false;
    }

    // Everything else: deny by default (implicit).
  }
}
