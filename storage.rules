rules_version = '2';

// Voice notes contain PHI audio - staff-only access.
service firebase.storage {
  match /b/{bucket}/o {
    // NEW-5: auth != null alone lets any self-minted Auth account (the
    // public API key makes signup scriptable) read/write PHI audio. Require
    // an ACTIVE staff profile in Firestore, mirroring firestore.rules.
    function isStaff() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    match /voice_messages/{fileName} {
      // Active staff can read voice notes for care coordination.
      allow read: if isStaff();

      // Uploads: active staff only, audio only, capped at 10 MB.
      allow write: if isStaff()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      allow delete: if false;
    }

    // Everything else: deny by default (implicit).
  }
}
