rules_version = '2';

// GEIMS Hospital - role-based Firestore rules.
//
// Model:
//  - Every caller must be an authenticated Firebase user that has a profile
//    document in /users (i.e. staff provisioned by an admin).
//  - Admins are users with role == 'admin'.
//  - Staff accounts are created ONLY via the admin dashboard. There is no
//    self-signup path in the app, and these rules enforce it: /users docs can
//    only be created by an admin.
//
// BOOTSTRAP: the first admin cannot be created through the app (chicken and
// egg). Create it once in the Firebase Console:
//  1. Authentication > Add user (email/password)
//  2. Firestore > create document /users/{that uid} with:
//     { role: 'admin', name: ..., email: ..., employeeId: ...,
//       isActive: true, createdAt: <now>, lastLoginAt: <now> }

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Any authenticated caller with an ACTIVE staff profile doc.
    // Uses get() (not exists()) so deactivating staff revokes their access
    // at the next rule evaluation - not just their next sign-in (NEW-7).
    function isStaff() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isAdmin() {
      return isSignedIn() && isStaff() && userDoc().role == 'admin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users ----------
    match /users/{userId} {
      // Staff rosters (doctor/nurse lists) are read by all staff; this is what
      // makes the admission form's doctor dropdown work.
      allow get, list: if isStaff();

      // No self-registration: profiles are created by admins only.
      allow create: if isAdmin()
        && request.resource.data.role in ['doctor', 'nurse', 'admin'];

      // Self-edits may touch profile fields only; role/isActive are
      // admin-controlled so nobody can promote themselves.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !changedKeys().hasAny(['role', 'isActive']));

      allow delete: if isAdmin();
    }

    // ---------- patients ----------
    match /patients/{patientId} {
      allow get, list: if isStaff();
      allow create: if isStaff();

      // patientCode/id/createdAt are immutable after admission.
      allow update: if isStaff()
        && !changedKeys().hasAny(['patientCode', 'id', 'createdAt']);

      allow delete: if isAdmin();
    }

    // ---------- vitals (append-only clinical record) ----------
    match /vitals/{vitalId} {
      allow get, list: if isStaff();
      allow create: if isStaff();
      // Entered vitals are never rewritten; corrections re-enter a new record.
      allow update, delete: if false;
    }

    // ---------- medications ----------
    match /medications/{medicationId} {
      allow get, list: if isStaff();
      allow create: if isStaff();
      // Administration updates the record; deletion is admin-only.
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- messages ----------
    match /messages/{messageId} {
      allow get, list: if isStaff();

      // Senders can't forge someone else as the sender.
      allow create: if isStaff()
        && request.resource.data.senderId == request.auth.uid;

      // Messages are immutable except delivery/read receipts. hasOnly()
      // on the affected keys = "only these fields may change" (NEW-1:
      // Set.subsetOf() does not exist in the rules language and broke
      // deployment).
      allow update: if isStaff()
        && changedKeys().hasOnly(['isDelivered', 'deliveredAt', 'isRead', 'readAt']);

      allow delete: if isAdmin();
    }

    // ---------- tasks ----------
    match /tasks/{taskId} {
      allow get, list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isStaff();
    }

    // ---------- config ----------
    // Scoped to the hospital layout doc explicitly: a wildcard /config/{id}
    // would ALSO match patient_counter below, and overlapping matches grant
    // access if ANY grants - letting an admin bypass the counter's monotonic
    // guard and reissue duplicate GEIMS codes.
    match /config/hospital {
      allow get, list: if isStaff();
      allow write: if isAdmin();
    }

    // The patient-code counter is written by any staff during admission
    // (atomic transaction), but it must stay MONOTONIC so codes can never be
    // reused or reset, and only the counter field may change.
    match /config/patient_counter {
      allow get, list: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['counter'])
        && request.resource.data.counter is int;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['counter'])
        && request.resource.data.counter is int
        && request.resource.data.counter > resource.data.counter;
      allow delete: if false;
    }

    // ---------- audit logs ----------
    match /audit_logs/{logId} {
      // Append-only; writers stamp their own uid.
      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }
  }
}
