rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Patients collection - authenticated users can read/write
    match /patients/{patientId} {
      allow read, write: if request.auth != null;
    }
    
    // Vitals collection - authenticated users can read/write
    match /vitals/{vitalId} {
      allow read, write: if request.auth != null;
    }
    
    // Medications collection - authenticated users can read/write
    match /medications/{medicationId} {
      allow read, write: if request.auth != null;
    }
    
    // Messages collection - authenticated users can read/write
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    // Tasks collection - authenticated users can read/write
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    
    // Config collection - authenticated users can read, admin can write
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Audit logs - authenticated users can create
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
